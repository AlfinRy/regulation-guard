{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "regulation-guard-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./knowledge",
    "binding": "ASSETS"
  },
  "limits": {
    "cpu_ms": 30000
  }
}
